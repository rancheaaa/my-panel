<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cq.panel.admin.server.repository.mapper.ArchDiagramCommentMapper">
    
    <resultMap type="ArchDiagramComment" id="ArchDiagramCommentResult">
        <result property="id"    column="id"    />
        <result property="diagramId"    column="diagram_id"    />
        <result property="nodeId"    column="node_id"    />
        <result property="edgeId"    column="edge_id"    />
        <result property="parentCommentId"    column="parent_comment_id"    />
        <result property="commentContent"    column="comment_content"    />
        <result property="commentPosition"    column="comment_position"    />
        <result property="commentType"    column="comment_type"    />
        <result property="attachments"    column="attachments"    />
        <result property="isResolved"    column="is_resolved"    />
        <result property="resolvedTime"    column="resolved_time"    />
        <result property="resolvedBy"    column="resolved_by"    />
        <result property="likeCount"    column="like_count"    />
        <result property="replyCount"    column="reply_count"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectArchDiagramCommentVo">
        select id, diagram_id, node_id, edge_id, parent_comment_id, comment_content, comment_position, comment_type, attachments, is_resolved, resolved_time, resolved_by, like_count, reply_count, status, create_by, create_time, update_time, del_flag from arch_diagram_comment
    </sql>

    <select id="selectArchDiagramCommentList" parameterType="ArchDiagramComment" resultMap="ArchDiagramCommentResult">
        <include refid="selectArchDiagramCommentVo"/>
        <where>  
            del_flag = '0'
            <if test="diagramId != null">diagram_id = #{diagramId}</if>
            <if test="nodeId != null"> and node_id = #{nodeId}</if>
            <if test="edgeId != null"> and edge_id = #{edgeId}</if>
            <if test="parentCommentId != null"> and parent_comment_id = #{parentCommentId}</if>
            <if test="commentType != null and commentType != ''"> and comment_type = #{commentType}</if>
            <if test="isResolved != null and isResolved != ''"> and is_resolved = #{isResolved}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectCommentsByDiagramId" parameterType="Long" resultMap="ArchDiagramCommentResult">
        <include refid="selectArchDiagramCommentVo"/>
        where diagram_id = #{diagramId} and del_flag = '0' and parent_comment_id is null
        order by create_time desc
    </select>

    <select id="selectCommentsByNodeId" parameterType="Long" resultMap="ArchDiagramCommentResult">
        <include refid="selectArchDiagramCommentVo"/>
        where node_id = #{nodeId} and del_flag = '0'
        order by create_time desc
    </select>

    <select id="selectCommentsByEdgeId" parameterType="Long" resultMap="ArchDiagramCommentResult">
        <include refid="selectArchDiagramCommentVo"/>
        where edge_id = #{edgeId} and del_flag = '0'
        order by create_time desc
    </select>

    <select id="selectRepliesByParentId" parameterType="Long" resultMap="ArchDiagramCommentResult">
        <include refid="selectArchDiagramCommentVo"/>
        where parent_comment_id = #{parentCommentId} and del_flag = '0'
        order by create_time asc
    </select>

    <select id="selectArchDiagramCommentById" parameterType="Long" resultMap="ArchDiagramCommentResult">
        <include refid="selectArchDiagramCommentVo"/>
        where id = #{id} and del_flag = '0'
    </select>
        
    <insert id="insertArchDiagramComment" parameterType="ArchDiagramComment" useGeneratedKeys="true" keyProperty="id">
        insert into arch_diagram_comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="diagramId != null">diagram_id,</if>
            <if test="nodeId != null">node_id,</if>
            <if test="edgeId != null">edge_id,</if>
            <if test="parentCommentId != null">parent_comment_id,</if>
            <if test="commentContent != null and commentContent != ''">comment_content,</if>
            <if test="commentPosition != null">comment_position,</if>
            <if test="commentType != null">comment_type,</if>
            <if test="attachments != null">attachments,</if>
            <if test="isResolved != null">is_resolved,</if>
            <if test="resolvedTime != null">resolved_time,</if>
            <if test="resolvedBy != null">resolved_by,</if>
            <if test="likeCount != null">like_count,</if>
            <if test="replyCount != null">reply_count,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="diagramId != null">#{diagramId},</if>
            <if test="nodeId != null">#{nodeId},</if>
            <if test="edgeId != null">#{edgeId},</if>
            <if test="parentCommentId != null">#{parentCommentId},</if>
            <if test="commentContent != null and commentContent != ''">#{commentContent},</if>
            <if test="commentPosition != null">#{commentPosition},</if>
            <if test="commentType != null">#{commentType},</if>
            <if test="attachments != null">#{attachments},</if>
            <if test="isResolved != null">#{isResolved},</if>
            <if test="resolvedTime != null">#{resolvedTime},</if>
            <if test="resolvedBy != null">#{resolvedBy},</if>
            <if test="likeCount != null">#{likeCount},</if>
            <if test="replyCount != null">#{replyCount},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateArchDiagramComment" parameterType="ArchDiagramComment">
        update arch_diagram_comment
        <trim prefix="SET" suffixOverrides=",">
            <if test="commentContent != null and commentContent != ''">comment_content = #{commentContent},</if>
            <if test="commentPosition != null">comment_position = #{commentPosition},</if>
            <if test="attachments != null">attachments = #{attachments},</if>
            <if test="isResolved != null">is_resolved = #{isResolved},</if>
            <if test="resolvedTime != null">resolved_time = #{resolvedTime},</if>
            <if test="resolvedBy != null">resolved_by = #{resolvedBy},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="incrementLikeCount" parameterType="Long">
        update arch_diagram_comment set like_count = like_count + 1 where id = #{id}
    </update>

    <update id="incrementReplyCount" parameterType="Long">
        update arch_diagram_comment set reply_count = reply_count + 1 where id = #{id}
    </update>

    <update id="markAsResolved" parameterType="Long">
        update arch_diagram_comment set is_resolved = '1', resolved_time = now() where id = #{id}
    </update>

    <delete id="deleteArchDiagramCommentById" parameterType="Long">
        update arch_diagram_comment set del_flag = '1' where id = #{id}
    </delete>

    <delete id="deleteArchDiagramCommentByIds" parameterType="String">
        update arch_diagram_comment set del_flag = '1' where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>