<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cq.panel.admin.server.repository.mapper.ArchDiagramHistoryMapper">
    
    <resultMap type="ArchDiagramHistory" id="ArchDiagramHistoryResult">
        <result property="id"    column="id"    />
        <result property="diagramId"    column="diagram_id"    />
        <result property="version"    column="version"    />
        <result property="versionName"    column="version_name"    />
        <result property="versionDescription"    column="version_description"    />
        <result property="diagramData"    column="diagram_data"    />
        <result property="thumbnail"    column="thumbnail"    />
        <result property="changeSummary"    column="change_summary"    />
        <result property="changeType"    column="change_type"    />
        <result property="isCurrent"    column="is_current"    />
        <result property="restoreCount"    column="restore_count"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectArchDiagramHistoryVo">
        select id, diagram_id, version, version_name, version_description, diagram_data, thumbnail, change_summary, change_type, is_current, restore_count, create_by, create_time, remark from arch_diagram_history
    </sql>

    <select id="selectArchDiagramHistoryList" parameterType="ArchDiagramHistory" resultMap="ArchDiagramHistoryResult">
        <include refid="selectArchDiagramHistoryVo"/>
        <where>  
            <if test="diagramId != null">diagram_id = #{diagramId}</if>
            <if test="version != null and version != ''"> and version like concat('%', #{version}, '%')</if>
            <if test="changeType != null and changeType != ''"> and change_type = #{changeType}</if>
            <if test="isCurrent != null and isCurrent != ''"> and is_current = #{isCurrent}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectHistoryByDiagramId" parameterType="Long" resultMap="ArchDiagramHistoryResult">
        <include refid="selectArchDiagramHistoryVo"/>
        where diagram_id = #{diagramId}
        order by create_time desc
    </select>

    <select id="selectArchDiagramHistoryById" parameterType="Long" resultMap="ArchDiagramHistoryResult">
        <include refid="selectArchDiagramHistoryVo"/>
        where id = #{id}
    </select>

    <select id="selectCurrentVersion" parameterType="Long" resultMap="ArchDiagramHistoryResult">
        <include refid="selectArchDiagramHistoryVo"/>
        where diagram_id = #{diagramId} and is_current = '1'
        limit 1
    </select>
        
    <insert id="insertArchDiagramHistory" parameterType="ArchDiagramHistory" useGeneratedKeys="true" keyProperty="id">
        insert into arch_diagram_history
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="diagramId != null">diagram_id,</if>
            <if test="version != null and version != ''">version,</if>
            <if test="versionName != null">version_name,</if>
            <if test="versionDescription != null">version_description,</if>
            <if test="diagramData != null">diagram_data,</if>
            <if test="thumbnail != null">thumbnail,</if>
            <if test="changeSummary != null">change_summary,</if>
            <if test="changeType != null">change_type,</if>
            <if test="isCurrent != null">is_current,</if>
            <if test="restoreCount != null">restore_count,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="diagramId != null">#{diagramId},</if>
            <if test="version != null and version != ''">#{version},</if>
            <if test="versionName != null">#{versionName},</if>
            <if test="versionDescription != null">#{versionDescription},</if>
            <if test="diagramData != null">#{diagramData},</if>
            <if test="thumbnail != null">#{thumbnail},</if>
            <if test="changeSummary != null">#{changeSummary},</if>
            <if test="changeType != null">#{changeType},</if>
            <if test="isCurrent != null">#{isCurrent},</if>
            <if test="restoreCount != null">#{restoreCount},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateArchDiagramHistory" parameterType="ArchDiagramHistory">
        update arch_diagram_history
        <trim prefix="SET" suffixOverrides=",">
            <if test="versionName != null">version_name = #{versionName},</if>
            <if test="versionDescription != null">version_description = #{versionDescription},</if>
            <if test="thumbnail != null">thumbnail = #{thumbnail},</if>
            <if test="changeSummary != null">change_summary = #{changeSummary},</if>
            <if test="isCurrent != null">is_current = #{isCurrent},</if>
            <if test="restoreCount != null">restore_count = #{restoreCount},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="updateCurrentVersion">
        update arch_diagram_history set is_current = '0' where diagram_id = #{diagramId}
    </update>

    <update id="updateHistoryToCurrent" parameterType="Long">
        update arch_diagram_history set is_current = '1' where id = #{historyId}
    </update>

    <delete id="deleteArchDiagramHistoryById" parameterType="Long">
        delete from arch_diagram_history where id = #{id}
    </delete>

    <delete id="deleteArchDiagramHistoryByIds" parameterType="String">
        delete from arch_diagram_history where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>