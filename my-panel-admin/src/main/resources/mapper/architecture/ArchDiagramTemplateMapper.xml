<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cq.panel.admin.server.repository.mapper.ArchDiagramTemplateMapper">
    
    <resultMap type="ArchDiagramTemplate" id="ArchDiagramTemplateResult">
        <result property="id"    column="id"    />
        <result property="templateName"    column="template_name"    />
        <result property="templateDescription"    column="template_description"    />
        <result property="templateCategory"    column="template_category"    />
        <result property="thumbnail"    column="thumbnail"    />
        <result property="templateData"    column="template_data"    />
        <result property="previewImage"    column="preview_image"    />
        <result property="tags"    column="tags"    />
        <result property="isSystem"    column="is_system"    />
        <result property="isPublic"    column="is_public"    />
        <result property="useCount"    column="use_count"    />
        <result property="rating"    column="rating"    />
        <result property="ratingCount"    column="rating_count"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectArchDiagramTemplateVo">
        select id, template_name, template_description, template_category, thumbnail, template_data, preview_image, tags, is_system, is_public, use_count, rating, rating_count, status, create_by, create_time, update_by, update_time, del_flag, remark from arch_diagram_template
    </sql>

    <select id="selectArchDiagramTemplateList" parameterType="ArchDiagramTemplate" resultMap="ArchDiagramTemplateResult">
        <include refid="selectArchDiagramTemplateVo"/>
        <where>  
            del_flag = '0'
            <if test="templateName != null and templateName != ''"> and template_name like concat('%', #{templateName}, '%')</if>
            <if test="templateCategory != null and templateCategory != ''"> and template_category = #{templateCategory}</if>
            <if test="isSystem != null and isSystem != ''"> and is_system = #{isSystem}</if>
            <if test="isPublic != null and isPublic != ''"> and is_public = #{isPublic}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by use_count desc, create_time desc
    </select>
    
    <select id="selectArchDiagramTemplateAll" resultMap="ArchDiagramTemplateResult">
        <include refid="selectArchDiagramTemplateVo"/>
        where del_flag = '0' and status = '0'
        order by use_count desc
    </select>

    <select id="selectArchDiagramTemplateById" parameterType="Long" resultMap="ArchDiagramTemplateResult">
        <include refid="selectArchDiagramTemplateVo"/>
        where id = #{id} and del_flag = '0'
    </select>
        
    <insert id="insertArchDiagramTemplate" parameterType="ArchDiagramTemplate" useGeneratedKeys="true" keyProperty="id">
        insert into arch_diagram_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name,</if>
            <if test="templateDescription != null">template_description,</if>
            <if test="templateCategory != null">template_category,</if>
            <if test="thumbnail != null">thumbnail,</if>
            <if test="templateData != null">template_data,</if>
            <if test="previewImage != null">preview_image,</if>
            <if test="tags != null">tags,</if>
            <if test="isSystem != null">is_system,</if>
            <if test="isPublic != null">is_public,</if>
            <if test="useCount != null">use_count,</if>
            <if test="rating != null">rating,</if>
            <if test="ratingCount != null">rating_count,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">#{templateName},</if>
            <if test="templateDescription != null">#{templateDescription},</if>
            <if test="templateCategory != null">#{templateCategory},</if>
            <if test="thumbnail != null">#{thumbnail},</if>
            <if test="templateData != null">#{templateData},</if>
            <if test="previewImage != null">#{previewImage},</if>
            <if test="tags != null">#{tags},</if>
            <if test="isSystem != null">#{isSystem},</if>
            <if test="isPublic != null">#{isPublic},</if>
            <if test="useCount != null">#{useCount},</if>
            <if test="rating != null">#{rating},</if>
            <if test="ratingCount != null">#{ratingCount},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateArchDiagramTemplate" parameterType="ArchDiagramTemplate">
        update arch_diagram_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name = #{templateName},</if>
            <if test="templateDescription != null">template_description = #{templateDescription},</if>
            <if test="templateCategory != null">template_category = #{templateCategory},</if>
            <if test="thumbnail != null">thumbnail = #{thumbnail},</if>
            <if test="templateData != null">template_data = #{templateData},</if>
            <if test="previewImage != null">preview_image = #{previewImage},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="isSystem != null">is_system = #{isSystem},</if>
            <if test="isPublic != null">is_public = #{isPublic},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="incrementUseCount" parameterType="Long">
        update arch_diagram_template set use_count = use_count + 1 where id = #{id}
    </update>

    <update id="updateRating">
        update arch_diagram_template 
        set rating = #{rating}, 
            rating_count = rating_count + 1 
        where id = #{id}
    </update>

    <delete id="deleteArchDiagramTemplateById" parameterType="Long">
        update arch_diagram_template set del_flag = '1' where id = #{id}
    </delete>

    <delete id="deleteArchDiagramTemplateByIds" parameterType="String">
        update arch_diagram_template set del_flag = '1' where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>