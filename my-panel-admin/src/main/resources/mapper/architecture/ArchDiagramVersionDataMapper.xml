<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cq.panel.admin.server.repository.mapper.ArchDiagramVersionDataMapper">

    <resultMap type="com.cq.panel.admin.server.repository.domain.ArchDiagramVersionData" id="ArchDiagramVersionDataResult">
        <id property="id" column="id" />
        <result property="versionId" column="version_id" />
        <result property="dataType" column="data_type" />
        <result property="dataContent" column="data_content" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="selectArchDiagramVersionDataVo">
        select id, version_id, data_type, data_content, create_time from arch_diagram_version_data
    </sql>

    <select id="selectArchDiagramVersionDataById" parameterType="Long" resultMap="ArchDiagramVersionDataResult">
        <include refid="selectArchDiagramVersionDataVo" />
        where id = #{id}
    </select>

    <select id="selectArchDiagramVersionDataList" parameterType="com.cq.panel.admin.server.repository.domain.ArchDiagramVersionData" resultMap="ArchDiagramVersionDataResult">
        <include refid="selectArchDiagramVersionDataVo" />
        <where>
            <if test="id != null"> and id = #{id}</if>
            <if test="versionId != null"> and version_id = #{versionId}</if>
            <if test="dataType != null and dataType != ''"> and data_type = #{dataType}</if>
        </where>
    </select>

    <select id="selectVersionDataByVersionId" parameterType="Long" resultMap="ArchDiagramVersionDataResult">
        <include refid="selectArchDiagramVersionDataVo" />
        where version_id = #{versionId}
    </select>

    <insert id="insertArchDiagramVersionData" parameterType="com.cq.panel.admin.server.repository.domain.ArchDiagramVersionData" useGeneratedKeys="true" keyProperty="id">
        insert into arch_diagram_version_data(
            version_id,
            data_type,
            data_content
        ) values (
            #{versionId},
            #{dataType},
            #{dataContent}
        )
    </insert>

    <update id="updateArchDiagramVersionData" parameterType="com.cq.panel.admin.server.repository.domain.ArchDiagramVersionData">
        update arch_diagram_version_data
        <set>
            <if test="versionId != null">version_id = #{versionId},</if>
            <if test="dataType != null and dataType != ''">data_type = #{dataType},</if>
            <if test="dataContent != null">data_content = #{dataContent},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteArchDiagramVersionDataById" parameterType="Long">
        delete from arch_diagram_version_data where id = #{id}
    </delete>

    <delete id="deleteArchDiagramVersionDataByIds" parameterType="Long[]">
        delete from arch_diagram_version_data where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteVersionDataByVersionId" parameterType="Long">
        delete from arch_diagram_version_data where version_id = #{versionId}
    </delete>

</mapper>