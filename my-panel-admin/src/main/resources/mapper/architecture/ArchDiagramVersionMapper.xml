<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cq.panel.admin.server.repository.mapper.ArchDiagramVersionMapper">

    <resultMap type="com.cq.panel.admin.server.repository.domain.ArchDiagramVersion" id="ArchDiagramVersionResult">
        <id property="id" column="id" />
        <result property="diagramId" column="diagram_id" />
        <result property="version" column="version" />
        <result property="versionName" column="version_name" />
        <result property="versionDescription" column="version_description" />
        <result property="changeSummary" column="change_summary" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="restoreCount" column="restore_count" />
        <result property="isCurrent" column="is_current" />
    </resultMap>

    <sql id="selectArchDiagramVersionVo">
        select id, diagram_id, version, version_name, version_description, change_summary, create_by, create_time, restore_count, is_current from arch_diagram_version
    </sql>

    <select id="selectArchDiagramVersionById" parameterType="Long" resultMap="ArchDiagramVersionResult">
        <include refid="selectArchDiagramVersionVo" />
        where id = #{id}
    </select>

    <select id="selectArchDiagramVersionList" parameterType="com.cq.panel.admin.server.repository.domain.ArchDiagramVersion" resultMap="ArchDiagramVersionResult">
        <include refid="selectArchDiagramVersionVo" />
        <where>
            <if test="id != null"> and id = #{id}</if>
            <if test="diagramId != null"> and diagram_id = #{diagramId}</if>
            <if test="version != null and version != ''"> and version = #{version}</if>
            <if test="versionName != null and versionName != ''"> and version_name like concat('%', #{versionName}, '%')</if>
            <if test="createBy != null and createBy != ''"> and create_by = #{createBy}</if>
            <if test="isCurrent != null and isCurrent != ''"> and is_current = #{isCurrent}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectVersionsByDiagramId" parameterType="Long" resultMap="ArchDiagramVersionResult">
        <include refid="selectArchDiagramVersionVo" />
        where diagram_id = #{diagramId}
        order by create_time desc
    </select>

    <insert id="insertArchDiagramVersion" parameterType="com.cq.panel.admin.server.repository.domain.ArchDiagramVersion" useGeneratedKeys="true" keyProperty="id">
        insert into arch_diagram_version(
            diagram_id,
            version,
            version_name,
            version_description,
            change_summary,
            create_by,
            is_current
        ) values (
            #{diagramId},
            #{version},
            #{versionName},
            #{versionDescription},
            #{changeSummary},
            #{createBy},
            #{isCurrent}
        )
    </insert>

    <update id="updateArchDiagramVersion" parameterType="com.cq.panel.admin.server.repository.domain.ArchDiagramVersion">
        update arch_diagram_version
        <set>
            <if test="diagramId != null">diagram_id = #{diagramId},</if>
            <if test="version != null and version != ''">version = #{version},</if>
            <if test="versionName != null">version_name = #{versionName},</if>
            <if test="versionDescription != null">version_description = #{versionDescription},</if>
            <if test="changeSummary != null">change_summary = #{changeSummary},</if>
            <if test="createBy != null and createBy != ''">create_by = #{createBy},</if>
            <if test="restoreCount != null">restore_count = #{restoreCount},</if>
            <if test="isCurrent != null and isCurrent != ''">is_current = #{isCurrent},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteArchDiagramVersionById" parameterType="Long">
        delete from arch_diagram_version where id = #{id}
    </delete>

    <delete id="deleteArchDiagramVersionByIds" parameterType="Long[]">
        delete from arch_diagram_version where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="updateCurrentVersionFlag" parameterType="java.util.Map">
        update arch_diagram_version
        set is_current = #{isCurrent}
        where diagram_id = #{diagramId}
    </update>

    <update id="incrementRestoreCount" parameterType="Long">
        update arch_diagram_version
        set restore_count = restore_count + 1
        where id = #{id}
    </update>

</mapper>