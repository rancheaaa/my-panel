<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cq.panel.admin.server.repository.mapper.BatchTransferOperationLogMapper">

    <resultMap type="BatchTransferOperationLog" id="BatchTransferOperationLogResult">
        <result property="id"    column="id"    />
        <result property="taskId"    column="task_id"    />
        <result property="operatorId"    column="operator_id"    />
        <result property="operatorName"    column="operator_name"    />
        <result property="operatorIp"    column="operator_ip"    />
        <result property="operationType"    column="operation_type"    />
        <result property="oldConfig"    column="old_config"    />
        <result property="newConfig"    column="new_config"    />
        <result property="remark"    column="remark"    />
        <result property="operationTime"    column="operation_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <insert id="insertBatchTransferOperationLog" parameterType="BatchTransferOperationLog" useGeneratedKeys="true" keyProperty="id">
        insert into batch_transfer_operation_log (
            task_id, operator_id, operator_name, operator_ip, operation_type, old_config, new_config, remark, operation_time, create_time
        ) values (
            #{taskId}, #{operatorId}, #{operatorName}, #{operatorIp}, #{operationType}, #{oldConfig}, #{newConfig}, #{remark}, #{operationTime}, CURRENT_TIMESTAMP
        )
    </insert>

    <select id="selectByTaskId" parameterType="Long" resultMap="BatchTransferOperationLogResult">
        select id, task_id, operator_id, operator_name, operator_ip, operation_type, old_config, new_config, remark, operation_time, create_time
        from batch_transfer_operation_log
        where task_id = #{taskId}
        order by operation_time desc
    </select>

    <select id="selectList" parameterType="BatchTransferOperationLog" resultMap="BatchTransferOperationLogResult">
        select * from batch_transfer_operation_log
        <where>
            <if test="taskId != null">and task_id = #{taskId}</if>
            <if test="operationType != null and operationType != ''">and operation_type = #{operationType}</if>
            <if test="operatorName != null and operatorName != ''">and operator_name like concat('%', #{operatorName}, '%')</if>
        </where>
        order by operation_time desc
    </select>

</mapper>
