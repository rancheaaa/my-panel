    <update id="updateTaskStatus">
        update batch_transfer_task set status = #{status}, update_time = CURRENT_TIMESTAMP where id = #{id}
    </update>

    <delete id="deleteBatchTransferTaskByIds" parameterType="Long">
        update batch_transfer_task set deleted = 1 where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>

