            <if test="backupMode != null">backup_mode = #{backupMode},</if>
            <if test="preserveDirStructure != null">preserve_dir_structure = #{preserveDirStructure},</if>
            <if test="transferMode != null">transfer_mode = #{transferMode},</if>
            <if test="routingStrategy != null">routing_strategy = #{routingStrategy},</if>
            <if test="routingConfig != null">routing_config = #{routingConfig},</if>
            <if test="status != null">status = #{status},</if>
            <if test="totalFiles != null">total_files = #{totalFiles},</if>
            <if test="totalSizeBytes != null">total_size_bytes = #{totalSizeBytes},</if>
            <if test="transferredFiles != null">transferred_files = #{transferredFiles},</if>
            <if test="transferredSizeBytes != null">transferred_size_bytes = #{transferredSizeBytes},</if>
            <if test="failedFiles != null">failed_files = #{failedFiles},</if>
            <if test="postProcessFiles != null">post_process_files = #{postProcessFiles},</if>
            <if test="postProcessFailed != null">post_process_failed = #{postProcessFailed},</if>
            <if test="startedAt != null">started_at = #{startedAt},</if>
            <if test="completedAt != null">completed_at = #{completedAt},</if>
